# Copy the billing section into backend/.env.local (git-ignored).
# .env is committed to git: never put payment keys there.

# --- Billing (Stripe TEST mode) ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# printed by: stripe listen --forward-to localhost:3000/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# filled in automatically by: npm run stripe:setup
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_SEARCH=
STRIPE_PORTAL_CONFIG=

# Where Stripe sends the user back after checkout / portal
FRONTEND_URL=http://localhost:5173

# --- Anchor API ---
# How often pending document hashes are batched and anchored (ms)
ANCHOR_EPOCH_MS=60000
