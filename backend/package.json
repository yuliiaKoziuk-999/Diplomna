{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate": "node scripts/migrate.js",
    "stripe:setup": "node scripts/stripe-setup.js",
    "stripe:listen": "stripe listen --forward-to localhost:3000/billing/webhook",
    "demo:db": "node scripts/demo-db.mjs"
  },
  "dependencies": {
    "@apollo/server": "^4.9.3",
    "@faker-js/faker": "^9.8.0",
    "@google-cloud/translate": "^9.1.0",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/apollo": "^12.0.7",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^3.0.1",
    "@nestjs/core": "^9.0.0",
    "@nestjs/graphql": "^12.0.8",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/schedule": "^2.1.0",
    "@nestjs/sequelize": "^9.0.2",
    "@nestjs/serve-static": "^4.0.0",
    "@tensorflow/tfjs": "^4.22.0",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "faker": "^6.6.6",
    "graphql": "^16.8.0",
    "graphql-redis-subscriptions": "^2.6.0",
    "graphql-upload": "^14.0.0",
    "ioredis": "^5.6.1",
    "js-sha256": "^0.11.0",
    "js-sha3": "^0.9.3",
    "leo-profanity": "^1.7.0",
    "ml-kmeans": "^6.0.0",
    "natural": "^8.0.1",
    "openai": "^4.102.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "profanity-check": "^0.0.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.2.0",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sklearn": "^1.0.0",
    "string-similarity": "^4.0.4",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/express": "^4.17.13",
    "@types/jest": "29.5.0",
    "@types/node": "18.15.11",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "embedded-postgres": "^17.5.0-beta.15",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "29.5.0",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.5",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "^4.7.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testEnvironment": "node"
  }
}
